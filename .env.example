# ─── Leyva Web Studio — environment variables ───────────────
# Copy to .env.local for local dev (next dev). .env.local is gitignored.
# For production on Cloudflare Workers, set these as secrets instead:
#   npx wrangler secret put OPENAI_API_KEY
#   npx wrangler secret put RESEND_API_KEY

# OpenAI — enables real AI replies in the chatbot (/api/chat).
# If empty/missing, the chatbot falls back to the built-in keyword
# assistant automatically. The package cards + lead capture keep working
# either way. The key is only ever used server-side.
OPENAI_API_KEY=

# Optional model override for the chatbot (default: gpt-4o-mini).
OPENAI_MODEL=

# Resend — sends contact-form quotes (/api/contact) and chatbot leads
# (/api/leads) to the studio inbox. If empty, leads are validated and
# logged but not emailed.
RESEND_API_KEY=

# Public conversion config (safe to expose in the browser bundle).
# Optional Cal.com / booking URL. Empty = booking CTAs fall back to
# contact or WhatsApp.
NEXT_PUBLIC_BOOKING_URL=

# Optional Cloudflare Web Analytics token. Empty = no analytics script.
NEXT_PUBLIC_CF_BEACON_TOKEN=
